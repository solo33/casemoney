# Compose settings. Copy to .env on the server; never commit the real file.
POSTGRES_DB=casemoney
POSTGRES_USER=casemoney
POSTGRES_PASSWORD=generate_a_long_random_value
PLATFORM_DATA_ROOT=/srv/solo32/platform
CASEMONEY_ENV_FILE=/srv/solo32/secrets/casemoney.env

# Use :80 for the first IP-only test. Replace with casemoney.ru after DNS cutover.
CASEMONEY_SITE_ADDRESS=:80
ACME_EMAIL=admin@example.com
WEB_CONCURRENCY=2
