# DB
DATABASE_URL=postgresql://postgres:password@localhost:5432/casemoney

# JWT
SECRET_KEY=changeme_long_random_string

# App URL (используется в ссылках в письмах активации и сброса пароля)
APP_URL=http://localhost:5173

# CORS — список доменов фронта через запятую (для прода)
# CORS_ORIGINS=https://app.casemoney.ru,https://casemoney.ru
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limiting — отключить в тестах (RATELIMIT_ENABLED=0)
# RATELIMIT_ENABLED=1

# Yandex Cloud Postbox HTTPS API - preferred for Render Free.
# The service account must have the postbox.sender role. The sender domain
# must be verified in Postbox. Never commit the real keys.
# POSTBOX_ACCESS_KEY_ID=
# POSTBOX_SECRET_ACCESS_KEY=
# POSTBOX_FROM_EMAIL=noreply@casemoney.ru
# POSTBOX_FROM_NAME=CaseMoney
# POSTBOX_ENDPOINT_URL=https://postbox.cloud.yandex.net

# SMTP — если не задано, письма выводятся в консоль (dev-режим)
# Пример для Gmail (нужен App Password, не основной пароль):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your@gmail.com
#   SMTP_PASSWORD=xxxx xxxx xxxx xxxx
#   SMTP_FROM=CaseMoney <your@gmail.com>
#   SMTP_STARTTLS=true
#
# Пример для Yandex (обычно нужен пароль приложения):
#   SMTP_HOST=smtp.yandex.com
#   SMTP_PORT=465
#   SMTP_USER=case.m0ney@ya.ru
#   SMTP_PASSWORD=app_password
#   SMTP_FROM=CaseMoney <case.m0ney@ya.ru>
#   SMTP_STARTTLS=false
#   SMTP_USE_SSL=true
#
# Пример для Mail.ru:
#   SMTP_HOST=smtp.mail.ru
#   SMTP_PORT=465
#   SMTP_USER=your@mail.ru
#   SMTP_PASSWORD=app_password
#   SMTP_FROM=CaseMoney <your@mail.ru>
#   SMTP_USE_SSL=true

# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=CaseMoney <noreply@casemoney.local>
# SMTP_STARTTLS=true
# SMTP_USE_SSL=false

# Brevo HTTPS API — работает на бесплатном Render, где SMTP-порты заблокированы.
# Если BREVO_API_KEY задан, Brevo используется вместо SMTP.
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=case.m0ney@ya.ru
# BREVO_SENDER_NAME=CaseMoney
