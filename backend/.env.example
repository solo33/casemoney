# AI Chat (виджет на сайте)
# Бесплатный ключ: https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIzaSyXXXX

# Финансовый AI-помощник (DeepSeek): используется только сервером для трёх
# фиксированных сценариев в разделе «Анализ». Ключ никогда не попадает во
# фронтенд, логи или Git. Лимит по умолчанию — 30 подсказок на пользователя
# за календарный месяц.
# DEEPSEEK_API_KEY=
# DEEPSEEK_FINANCE_MODEL=deepseek-chat
# DEEPSEEK_FINANCE_MONTHLY_LIMIT=30
# DEEPSEEK_FINANCE_MIN_INTERVAL_SECONDS=15

# DB
DATABASE_URL=postgresql://postgres:password@localhost:5432/casemoney

# JWT
SECRET_KEY=changeme_long_random_string

# App URL (используется в ссылках в письмах активации и сброса пароля)
APP_URL=http://localhost:5173

# Email for service-owner notifications about every successful registration.
REGISTRATION_NOTIFY_EMAIL=andrey.zakhartsev@gmail.com

# CORS — список доменов фронта через запятую (для прода)
# CORS_ORIGINS=https://app.casemoney.ru,https://casemoney.ru
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limiting — отключить в тестах (RATELIMIT_ENABLED=0)
# RATELIMIT_ENABLED=1

# Проверка ближайших платежей по кредитам. В production включена по умолчанию
# и выполняется раз в час; в тестах автоматически отключается.
# CREDIT_REMINDER_WORKER_ENABLED=1
# CREDIT_REMINDER_INTERVAL_SECONDS=3600

# Публичная кнопка «Демо-вход» создаёт изолированный одноразовый аккаунт на
# сессию (POST /api/auth/demo) и удаляется фоновым воркером через ~4 часа.
# DEMO_CLEANUP_WORKER_ENABLED=1
# DEMO_CLEANUP_INTERVAL_SECONDS=1800

# Статический test@test.com — только для локальной разработки, по умолчанию
# выключен (не создаётся автоматически, в т.ч. на проде).
# SEED_STATIC_DEMO=0

# Платная подписка Family через ЮKassa. Без ключей экран тарифа работает,
# но создание платежа безопасно отключено.
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# FAMILY_MONTHLY_PRICE_RUB=299
# YOOKASSA_SEND_RECEIPT=0
# YOOKASSA_VAT_CODE=1
# BILLING_WORKER_ENABLED=1
# BILLING_WORKER_INTERVAL_SECONDS=3600
# FAMILY_TEST_MONTH_PRICE_RUB=299
# FAMILY_TEST_YEAR_PRICE_RUB=2990

# Yandex Cloud Postbox HTTPS API - preferred for Render Free.
# The service account must have the postbox.sender role. The sender domain
# must be verified in Postbox. Never commit the real keys.
# POSTBOX_ACCESS_KEY_ID=
# POSTBOX_SECRET_ACCESS_KEY=
# POSTBOX_FROM_EMAIL=noreply@casemoney.ru
# POSTBOX_FROM_NAME=CaseMoney
# POSTBOX_ENDPOINT_URL=https://postbox.cloud.yandex.net

# SMTP — если не задано, письма выводятся в консоль (dev-режим)
# Пример для Gmail (нужен App Password, не основной пароль):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your@gmail.com
#   SMTP_PASSWORD=xxxx xxxx xxxx xxxx
#   SMTP_FROM=CaseMoney <your@gmail.com>
#   SMTP_STARTTLS=true
#
# Пример для Yandex (обычно нужен пароль приложения):
#   SMTP_HOST=smtp.yandex.com
#   SMTP_PORT=465
#   SMTP_USER=case.m0ney@ya.ru
#   SMTP_PASSWORD=app_password
#   SMTP_FROM=CaseMoney <case.m0ney@ya.ru>
#   SMTP_STARTTLS=false
#   SMTP_USE_SSL=true
#
# Пример для Mail.ru:
#   SMTP_HOST=smtp.mail.ru
#   SMTP_PORT=465
#   SMTP_USER=your@mail.ru
#   SMTP_PASSWORD=app_password
#   SMTP_FROM=CaseMoney <your@mail.ru>
#   SMTP_USE_SSL=true

# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=CaseMoney <noreply@casemoney.local>
# SMTP_STARTTLS=true
# SMTP_USE_SSL=false

# Brevo HTTPS API — работает на бесплатном Render, где SMTP-порты заблокированы.
# Если BREVO_API_KEY задан, Brevo используется вместо SMTP.
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=case.m0ney@ya.ru
# BREVO_SENDER_NAME=CaseMoney
